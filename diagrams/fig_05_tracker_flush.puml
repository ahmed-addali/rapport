@startuml fig_05_tracker_flush
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Inter
skinparam sequenceFontSize 11

actor "Utilisateur" as U
participant "JS Tracker" as T
participant "FastAPI\n/api/recommend/event" as API
database "RAM Cache\n(30s TTL)" as RAM
database "PostgreSQL\nRecommendationEvent" as DB

== Flush normal (toutes les 15s ou 20 events) ==

U -> T : click / scroll / wishlist / reservation
T -> T : _queue.push(event)
T -> T : _queue.length >= 20 ?

T -> API : POST {session_id, events[], session_state, session_rewards}
activate API

loop pour chaque event
    API -> API : compute_reward(delta)
    API -> DB : INSERT RecommendationEvent
    API -> DB : UPDATE BanditArm (alpha, beta)
    API -> RAM : Invalider le cache
end

API --> T : {processed: N, session_rewards: {...}}
deactivate API
T -> T : _sessionRewards = response.session_rewards

@enduml