@startuml
skinparam backgroundColor #FEFEFE

skinparam defaultFontName "Arial"

title Schéma ER du sous-système de recommandation LinUCB (Cohérent)

!define table entity

entity "BanditArmUCB" as BA {
  * id : UUID <<PK>>
  --
  * listingId : UUID
  * listingType : VARCHAR
  * locationZone : VARCHAR
  * tags : JSON
  * commissionRate : DECIMAL
  * impressions : INT
  * clicks : INT
  * wishlists : INT
  * conversions : INT
  * totalRevenue : DECIMAL
  * nUpdates : INT
  * isUnderexposed : BOOLEAN
  * updatedAt : TIMESTAMP
  --
  <<UQ>> (listingId, listingType, locationZone)
}

entity "LinUCBGlobal" as LG {
  * id : UUID <<PK>>
  --
  * aMatrix : JSON [360×360]
  * bVector : JSON [360]
  * d : INT
  * vocabHash : VARCHAR
  * nUpdates : INT
  * updatedAt : TIMESTAMP
}

entity "UserProfile" as UP {
  * userId : UUID <<PK>>
  --
  * tagAffinity : JSON
  * avgBookingPrice : DECIMAL
  * priceStdDev : DECIMAL
  * dominantTripType : VARCHAR
  * totalBookings : INT
  * updatedAt : TIMESTAMP
}

entity "UserSession" as US {
  * id : UUID <<PK>>
  --
  * sessionId : VARCHAR <<UQ>>
  * userId : UUID <<FK>> (nullable)
  * locationLat : DECIMAL
  * locationLon : DECIMAL
  * deviceType : VARCHAR
  * entryHour : INT
  * entryMonth : INT
  * scrollDepthMax : DECIMAL
  * dwellSeconds : DECIMAL
  * clickSequence : JSON
  * priceRangeViewed : JSON
  * budgetSegment : VARCHAR
  * createdAt : TIMESTAMP
}

entity "RecommendationEventUCB" as RE {
  * id : UUID <<PK>>
  --
  * eventType : VARCHAR
  * listingId : UUID
  * listingType : VARCHAR
  * userId : UUID <<FK>> (nullable)
  * sessionId : VARCHAR
  * locationZone : VARCHAR
  * reward : DECIMAL
  * rankShown : INT (nullable)
  * price : DECIMAL (nullable)
  * metadata : JSON
  * createdAt : TIMESTAMP
}

entity "ListingTag" as LT {
  * id : UUID <<PK>>
  --
  * listingId : UUID
  * listingType : VARCHAR
  * tags : JSON
  * confidence : FLOAT
  --
  <<UQ>> (listingId, listingType)
}

entity "SystemConfig" as SC {
  * key : VARCHAR <<PK>>
  --
  * value : TEXT
  * updatedAt : TIMESTAMP
}

' ============================================================
' RELATIONS (VISUELLES)
' ============================================================

UP ||--o{ US : "possède"
US ||--o{ RE : "génère"
BA ||--o{ RE : "est recommandé dans"
LT ||--o{ BA : "catégorise"

@enduml