@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Arial"

title Schéma ER du sous-système de recommandation Hybrid Thompson Sampling

!define table entity

entity "User" as U {
  * id : VARCHAR <<PK>>
  --
  * email : VARCHAR
  * name : VARCHAR
}

entity "BanditArm" as BA {
  * id : VARCHAR <<PK>>
  --
  * listingId : VARCHAR
  * listingType : VARCHAR
  * segment : VARCHAR
  * alpha : FLOAT
  * beta : FLOAT
  * impressions : INT
  * clicks : INT
  * wishlists : INT
  * conversions : INT
  * totalRevenue : FLOAT
  * updatedAt : TIMESTAMP
  --
  <<UQ>> (listingId, listingType, segment)
}

entity "RecommendationEvent" as RE {
  * id : VARCHAR <<PK>>
  --
  * eventType : VARCHAR
  * listingId : VARCHAR
  * listingType : VARCHAR
  * userId : VARCHAR <<FK>> (nullable)
  * sessionId : VARCHAR
  * segment : VARCHAR
  * reward : FLOAT
  * price : FLOAT (nullable)
  * metadata : JSON
  * createdAt : TIMESTAMP
}

' ============================================================
' RELATIONS
' ============================================================

' Un User peut générer plusieurs RecommendationEvents (1 à N)
U ||--o{ RE : "génère"

' Un BanditArm est mis à jour suite à des RecommendationEvents
BA ||--o{ RE : "enregistre"

@enduml