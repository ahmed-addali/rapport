@startuml Guidni_Deployment_Diagram

skinparam shadow depth 1
skinparam backgroundColor white
skinparam componentStyle uml2

skinparam node {
    BackgroundColor #F5F5F5
    BorderColor #333333
}

skinparam cloud {
    BackgroundColor #E8F4F8
    BorderColor #2B7A9B
}

skinparam database {
    BackgroundColor #EFEFEF
    BorderColor #333333
}

title __Diagramme de Déploiement Physique - Plateforme Guidni__\n

client . [Navigateur Web / Mobile] : "Utilisateurs (Voyageurs)"

cloud "Internet Public" {
    [HTTPS (Port 443)] as Internet
}

node "Serveur Privé Virtuel (VPS) d'Hébergement" <<Ubuntu LTS>> {
    
    node "Serveur Web Hôte" {
        [Nginx (Reverse Proxy & SSL)] as nginx #D4EDDA
    }
    
    node "Réseau Virtuel Interne Docker" <<bridge: guidni-network>> #FCF8E3 {
        
        node "Conteneur Presentation" <<Next.js (React 19)>> {
            [Application Web (guidni-next)] as nextapp #D1ECF1
        }
        
        node "Conteneur Agent Planificateur" <<FastAPI (Asynchrone)>> {
            [Planner Agent (guidni-planner)] as planner #D1ECF1
        }
        
        node "Conteneur Moteur de Recommandation" <<FastAPI>> {
            [Brain Engine (guidni-brain)] as brain #D1ECF1
        }
        
        node "Conteneur Base Vectorielle" <<Qdrant (RAG Engine)>> {
            database "Index Vectoriels (Qdrant)" as qdrant_db #E8F4F8
        }
        
        node "Conteneur Base Relationnelle" <<PostgreSQL>> {
            database "guidni_db (Postgres)" as db
        }
        
        node "Volumes Persistants" {
            storage "postgres_data" as vol_pg #E2E3E5
            storage "qdrant_data" as vol_qd #E2E3E5
        }
    }
}

cloud "Fournisseurs Cloud AI Externes" <<Services Managés>> #F8D7DA {
    [API LLM (Groq / Anthropic / Gemini)] as cloud_ai
}

' ---- Liaisons ----

[Navigateur Web / Mobile] --> Internet : " Requêtes HTTP/HTTPS"
Internet --> nginx : " Traversée du Firewall"
nginx --> nextapp : " proxy_pass (Port 3000)"

' Communications Applicatives Inter-conteneurs
nextapp --> planner : " REST API (Port 8000)"
nextapp --> brain : " REST API (Port 8001)"

' Accès Vectoriel Qdrant par le Planner
planner --> qdrant_db : " Requêtes de Similarité\n(Port 6333)"

' Accès SQL PostgreSQL
nextapp --> db : " Prisma Client (Port 5432)"
planner --> db : " asyncpg (Port 5432)"
brain --> db : " psycopg2 (Port 5432)"

' Association de persistance volumes
db -- vol_pg
qdrant_db -- vol_qd

' Appel Cloud LLM Externe
planner --> cloud_ai : " Inférence HTTPS (Clé API)"

@enduml