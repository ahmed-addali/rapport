@startuml
skinparam backgroundColor #FEFEFE

skinparam defaultFontName "Arial"

title Schéma ER du sous-système agent planificateur (Cohérent)

!define table entity

entity "User" as User {
  * id : UUID <<PK>>
  --
  * name : VARCHAR
  * email : VARCHAR <<UQ>>
  * country : VARCHAR
  * city : VARCHAR
  * createdAt : TIMESTAMP
}

entity "PlannerConversation" as PC {
  * id : UUID <<PK>>
  --
  * userId : UUID <<FK>>
  * title : VARCHAR
  * contextSummary : JSON
  * isActive : BOOLEAN
  * createdAt : TIMESTAMP
  * updatedAt : TIMESTAMP
}

entity "PlannerMessage" as PM {
  * id : UUID <<PK>>
  --
  * conversationId : UUID <<FK>>
  * role : VARCHAR
  * content : TEXT
  * messageType : VARCHAR
  * metadata : JSON
  * createdAt : TIMESTAMP
}

entity "GeneratedPlan" as GP {
  * id : UUID <<PK>>
  --
  * conversationId : UUID <<FK>>
  * planData : JSON
  * version : INT
  * isActive : BOOLEAN
  * createdAt : TIMESTAMP
}

entity "Activity" as Activity {
  * id : UUID <<PK>>
  --
  * slug : VARCHAR
  * title : VARCHAR
  * category : VARCHAR
  * price : DECIMAL
  * region : VARCHAR
  * duration : INT
  * capacity : INT
  * destinationId : UUID <<FK>>
  * businessProfileId : UUID <<FK>>
}

entity "ActivityIntelligence" as AI {
  * id : UUID <<PK>>
  --
  * activityId : UUID <<FK>> <<UQ>>
  * enrichmentData : JSON
  * updatedAt : TIMESTAMP
}

User ||--o{ PC : "possède"
PC ||--o{ PM : "contient"
PC ||--o{ GP : "génère"
Activity ||--|| AI : "enrichit"

@enduml