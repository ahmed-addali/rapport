@startuml
skinparam backgroundColor #FEFEFE

skinparam defaultFontName "Arial"

left to right direction
skinparam packageStyle rectangle

actor "Touriste" as Tourist
actor "Administrateur" as Admin
actor "Système" as System

rectangle "Système Guidni" {

  Tourist --> (Démarrer une conversation)
  Tourist --> (Envoyer un message de planification)
  Tourist --> (Recevoir un plan de voyage)
  Tourist --> (Modifier un plan existant)
  Tourist --> (Consulter l'historique de conversation)
  Tourist --> (Archiver une conversation)

  (Modifier un plan existant) .-> (Envoyer un message de planification) : <<extend>>
  (Recevoir un plan de voyage) ..> (Valider le plan) : <<include>>

  Admin --> (Reconstruire l'index RAG)
  Admin --> (Consulter l'état de santé du système)
  Admin --> (Choisir le fournisseur LLM)

  System --> (Tracker les événements comportementaux)
  System --> (Mettre à jour les matrices LinUCB)
  System --> (Exécuter les jobs nocturnes)
  System --> (Réindexer automatiquement)
}


@enduml