@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Arial"

title Flux d'exécution de l'outil create_plan_structure

participant "THINK Node" as Think
participant "LLM Provider" as LLM
participant "EXECUTE_TOOL Node" as Exec
participant "AgentState" as State

' AIMessage هو الرد اللي يجي من الـ LLM موش Participant
Think -> LLM : Requête de génération de plan
LLM --> Think : AIMessage(tool_calls=[{name:"create_plan_structure", args:{plan_json:"..."}}])

Think -> Exec : _should_continue → "execute_tool"

' الدالة create_plan_structure هي استدعاء داخلي في العقدة المُنفذة للأدوات
Exec -> Exec : create_plan_structure(plan_json)

Exec -> Exec : Validation structure JSON

alt Plan valide
  Exec -> State : is_plan_ready = True
  Exec -> State : current_plan = plan
  Exec -> State : thinking_steps += "✅ create_plan_structure completed"

  Exec --> Think : État mis à jour (Retour au noeud principal)

else Plan invalide
  Exec -> State : thinking_steps += "❌ create_plan_structure failed"

  Exec --> Think : Erreur interceptée (Retour au LLM)
end

@enduml