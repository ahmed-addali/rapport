@startuml
skinparam backgroundColor #FEFEFE
skinparam handwritten false
skinparam defaultFontName "Arial"

title Cycle complet du bandit LinUCB dans le système Guidni

start
:Démarrage session;
:Construction du contexte φ
(build_user_vector + tags);

:Chargement des bras
get_arms_for_zone();
note right
  Cache 30s, JOIN sur
  BanditArm + ListingTag +
  tables listing
end note

:Construction φ par bras
build_phi(x_user, x_tags);
note right
  Kronecker product
  np.kron(x_user, x_tags)
  → 360 dimensions
end note

:Scoring LinUCB
score_arms(A, b, phi);
note right
  exploitation = θ̂ᵀφ
  UCB bonus = α√(φᵀA⁻¹φ)
  underexposed bonus = +0.15
  position discount = 1/log₂(rank+1)
end note

:Pipeline de classement
10 étapes post-traitement;
note right
  time filter, budget filter,
  diversity, new listing guarantee,
  tag exploration, margin sort
end note

:Affichage des recommandations
top-k résultats;

:Interaction utilisateur
(clic, dwell, wishlist, réservation);

:Tracker JS → POST /events;
:compute_reward() → delta reward;

:Update matrices
A ← A + φφᵀ
b ← b + r·φ;
note right
  UNIQUEMENT en RAM
  (pas d'écriture DB ici)
end note

:Persist matrices to DB
(toutes les 2 minutes);
stop

@enduml