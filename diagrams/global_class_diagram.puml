@startuml

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
    FontSize 12
}

' ============================================================
' CORE LISTINGS
' ============================================================

class Activity {
    +UUID id
    +String slug
    +String title
    +String category
    +Decimal price
    +String region
    +Int duration
    +Int capacity
    --
    +businessProfileId
    +images[]
    +reservations[]
    +attractions[]
    +timeSlots[]
}

class Stay {
    +UUID id
    +String slug
    +String title
    +String type
    +Decimal pricePerNight
    +String region
    +Int capacity
    --
    +businessProfileId
    +images[]
    +reservations[]
    +blockedDates[]
}

class Restaurant {
    +UUID id
    +String slug
    +String name
    +String cuisine
    +String priceRange
    +String region
    +Int capacity
    --
    +businessProfileId
    +images[]
    +menu[]
    +hours[]
    +reservations[]
}

class Rental {
    +UUID id
    +String slug
    +String title
    +String type
    +Decimal pricePerDay
    +String region
    +Int capacity
    --
    +businessProfileId
    +images[]
    +reservations[]
    +blockedDates[]
}

class Transfer {
    +UUID id
    +String slug
    +String title
    +String type
    +Decimal price
    +String region
    +Int capacity
    --
    +businessProfileId
    +images[]
    +reservations[]
    +blockedDates[]
}

class Attraction {
    +UUID id
    +String title
    +String slug
    +String category
    +String region
    --
    +images[]
    +activities[]
}

' ============================================================
' USER & PLANNER
' ============================================================

class User {
    +UUID id
    +String name
    +String email
    +String country
    +String city
    +DateTime createdAt
    --
    +plans[]
    +planConversations[]
    +sentPlanMessages[]
    +activityReservations[]
    +staysReservations[]
    +restaurantReservations[]
    +rentalReservations[]
    +transferReservations[]
}

class PlannerConversation {
    +UUID id
    +String title
    +JSON contextSummary
    +Boolean isActive
    +DateTime createdAt
    +DateTime updatedAt
    --
    +userId
    +messages[]
    +plans[]
}

class PlannerMessage {
    +UUID id
    +String role
    +String content
    +String messageType
    +JSON metadata
    +DateTime createdAt
    --
    +conversationId
}

class GeneratedPlan {
    +UUID id
    +JSON planData
    +Int version
    +Boolean isActive
    +DateTime createdAt
    --
    +conversationId
    +userId
}

class ActivityIntelligence {
    +UUID id
    +JSON enrichmentData
    +DateTime updatedAt
    --
    +activityId
}

' ============================================================
' RECOMMENDATION SYSTEM
' ============================================================

class BanditArmUCB {
    +UUID id
    +String listingId
    +String listingType
    +String locationZone
    +Json tags
    +Float commissionRate
    +Int impressions
    +Int clicks
    +Int wishlists
    +Int conversions
    +Float totalRevenue
    +Int nUpdates
    +Boolean isUnderexposed
    +DateTime updatedAt
}

class LinUCBGlobal {
    +UUID id
    +Json aMatrix
    +Json bVector
    +Int d
    +String vocabHash
    +Int nUpdates
    +DateTime updatedAt
}

class SystemConfig {
    +String key
    +String value
    +DateTime updatedAt
}

class ListingTag {
    +UUID id
    +UUID listingId
    +String listingType
    +Json tags
    +Float confidence
}

class UserProfile {
    +UUID userId
    +Json tagAffinity
    +Float avgBookingPrice
    +Float priceStdDev
    +String dominantTripType
    +Int totalBookings
    +DateTime updatedAt
}

class UserSession {
    +UUID id
    +UUID sessionId
    +UUID userId
    +Float locationLat
    +Float locationLon
    +String deviceType
    +Int entryHour
    +Int entryMonth
    +Float scrollDepthMax
    +Float dwellSeconds
    +Json clickSequence
    +Json priceRangeViewed
    +String budgetSegment
    +DateTime createdAt
}

class RecommendationEventUCB {
    +UUID id
    +String eventType
    +UUID listingId
    +String listingType
    +UUID userId
    +UUID sessionId
    +String locationZone
    +Float reward
    +Int rankShown
    +Float price
    +Json metadata
    +DateTime createdAt
}

' ============================================================
' RELATIONSHIPS
' ============================================================



' User relationships
User "1" -- "*" PlannerConversation 
User "1" -- "*" PlannerMessage 

' Planner flow
PlannerConversation "1" -- "*" PlannerMessage 
PlannerConversation "1" -- "*" GeneratedPlan 

' Activity intelligence
ActivityIntelligence "1" -- "1" Activity 

' Recommendation system relationships
BanditArmUCB "*" -- "1" ListingTag 
BanditArmUCB "*" -- "1" UserProfile 
RecommendationEventUCB "*" -- "1" UserSession 
RecommendationEventUCB "*" -- "1" BanditArmUCB 
UserSession "*" -- "0..1" User 
UserProfile "1" -- "1" User 
ListingTag "*" -- "1" Activity 
ListingTag "*" -- "1" Stay 
ListingTag "*" -- "1" Restaurant 
ListingTag "*" -- "1" Rental 
ListingTag "*" -- "1" Transfer 
ListingTag "*" -- "1" Attraction 

@enduml