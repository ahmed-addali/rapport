@startuml

skinparam classAttributeIconSize 0
skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
    FontSize 12
}

' ============================================================
' CORE LISTINGS
' ============================================================

class Activity {
    +UUID id
    +String slug
    +String title
    --
    +destination
    +businessProfile
    +images[]
    +reservations[]
    +attractions[]
    +timeSlots[]
}

class Stay {
    +UUID id
    +String slug
    +String title
    --
    +destination
    +businessProfile
    +images[]
    +reservations[]
    +blockedDates[]
}

class Restaurant {
    +UUID id
    +String slug
    +String name
    --
    +destination
    +businessProfile
    +images[]
    +menu[]
    +hours[]
    +reservations[]
}

class Rental {
    +UUID id
    +String slug
    +String title
    --
    +destination
    +businessProfile
    +images[]
    +reservations[]
    +blockedDates[]
}

class Transfer {
    +UUID id
    +String slug
    +String title
    --
    +destination
    +businessProfile
    +images[]
    +reservations[]
    +blockedDates[]
}

class Attraction {
    +UUID id
    +String title
    +String slug
    --
    +destination
    +images[]
    +activities[]
}

' ============================================================
' USER & PLANNER
' ============================================================

class User {
    +UUID id
    +String name
    +String email
    +String country
    +String city
    --
    +plans[]
    +planConversations[]
    +sentPlanMessages[]
    +activityReservations[]
    +staysReservations[]
    +restaurantReservations[]
    +rentalReservations[]
    +transferReservations[]
}

class PlannerConversation {
    +UUID id
    +String title
    --
    +user
    +messages[]
    +plans[]
}

class PlannerMessage {
    +UUID id
    +String role
    +String content
    --
    +conversation
}

class GeneratedPlan {
    +UUID id
    +JSON planData
    --
    +conversation
}

class ActivityIntelligence {
    +UUID id
    +String activityId
    +JSON enrichmentData
}

' ============================================================
' RECOMMENDATION SYSTEM (NEW TABLES)
' ============================================================

class BanditArm {
    +UUID id
    +String armId
    +String segmentKey
    +Float alpha
    +Float beta
    +Int impressions
    +Int clicks
    +Int wishlists
    +Int conversions
    +Float totalRevenue
    +DateTime updatedAt
}

class SystemConfig {
    +String key
    +String value
    +DateTime updatedAt
}

class ListingTag {
    +UUID id
    +UUID listingId
    +String listingType
    +Json tags
    +Float confidence
}

class UserProfile {
    +UUID userid
    +Json tagAffinity
    +Float avgBookingPrice
    +String dominantTripType
    +Int totalBookings
}

class UserSession {
    +UUID id
    +UUID sessionId
    +UUID userid
    +Float locationLat
    +Float locationLon
    +String deviceType
    +Int entryHour
    +Int entryMonth
    +Float scrollDepthMax
    +Float dwellSeconds
    +Json clickSequence
    +Json priceRangeViewed
    +String budgetSegment
    +DateTime createdAt
}

class RecommendationEvent {
    +UUID id
    +String eventType
    +UUID listingId
    +String listingType
    +UUID userid
    +UUID sessionId
    +String locationZone
    +Float reward
    +Int rankShown
    +Float price
    +Json metadata
    +DateTime createdAt
}

' ============================================================
' RELATIONSHIPS
' ============================================================

' Core listings to destinations/business
Activity "*" -- "0..1" Destination 
Stay "*" -- "0..1" Destination 
Restaurant "*" -- "0..1" Destination 
Rental "*" -- "0..1" Destination 
Transfer "*" -- "0..1" Destination 
Attraction "*" -- "0..1" Destination 

' User relationships
User "1" -- "*" PlannerConversation 
User "1" -- "*" PlannerMessage 


' Planner flow
PlannerConversation "1" -- "*" PlannerMessage 
PlannerConversation "1" -- "*" GeneratedPlan 

' Activity intelligence
ActivityIntelligence "1" -- "1" Activity 

' Recommendation system relationships
BanditArm "*" -- "1" ListingTag 
BanditArm "*" -- "1" UserProfile 
RecommendationEvent "*" -- "1" UserSession 
RecommendationEvent "*" -- "1" BanditArm  
UserSession "*" -- "0..1" User 
UserProfile "1" -- "1" User 
ListingTag "*" -- "1" Activity 
ListingTag "*" -- "1" Stay 
ListingTag "*" -- "1" Restaurant 
ListingTag "*" -- "1" Rental 
ListingTag "*" -- "1" Transfer 
ListingTag "*" -- "1" Attraction 

@enduml