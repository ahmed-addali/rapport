@startuml
skinparam backgroundColor #FEFEFE
skinparam defaultFontName "Arial"

title Flux de sécurité et de validation dans l'endpoint /chat

actor "Client" as Client
participant "FastAPI POST /chat" as FastAPI
participant "PostgreSQL User table" as DB

' تم إصلاح الخطأ هنا: تعويض اسم الدالة باسم المكون الفعلي
participant "Agent LangGraph" as Agent
participant "LLM Provider" as LLM

Client -> FastAPI : POST /chat {user_id, message, model?}
FastAPI -> DB : SELECT FROM "User" WHERE id = user_id

alt Utilisateur non trouvé
  DB --> FastAPI : ∅
  FastAPI --> Client : HTTP 404 {detail: "User not found"}
else Utilisateur trouvé
  DB --> FastAPI : User row

  FastAPI -> FastAPI : parse model_id si fourni ("groq/llama-3.3-70b")

  ' run_agent() هي الرسالة التي تُرسل للمكون Agent
  FastAPI -> Agent : run_agent(state)

  Agent -> LLM : System prompt + contexte + tool results

  LLM --> Agent : Réponse AIMessage
  Agent --> FastAPI : PlannerResponse
  FastAPI --> Client : 200 OK {conversation_id, content, ...}
end

@enduml