@startuml
skinparam backgroundColor #FEFEFE
skinparam handwritten false
skinparam defaultFontName "Arial"

title Architecture du pipeline RAG avec réindexation automatique

!define RECTANGLE class

package "Phase d'Indexation (Startup)" {
  rectangle "PostgreSQL(Activity, Stay,Yummy, Attraction,Rental, Transfer)" as PG1 #LightBlue
  rectangle "Document Builders(_activity_to_document,_stay_to_document, etc.)" as Builders #LightGreen
  rectangle "BAAI/bge-m3 Embeddings 768-d" as Embed #LightYellow
  rectangle "VectorStoreIndex (LlamaIndex)" as Index #LightCoral
  rectangle "rag_storage/(persistance disque)" as Storage #LightGray
  rectangle "SQLAlchemy Event Listeners" as Events #LightBlue
}

package "Phase de Requête (Runtime)" {
  rectangle "Requête utilisateur (rag_query())" as Query #LightGreen
  rectangle "Filtres métadonnées (entity_type, prix, région)" as Filters #LightYellow
  rectangle "Retriever retrieve(top_k×2)" as Retriever #LightCoral
  rectangle "Post-filtrage (score ≥ 0.1, max_price, type)" as PostFilter #LightGray
  rectangle "Résultats top-k (entity_id, title, score, snippet)" as Results #LightBlue
}

PG1 --> Builders : Ligne ORM
Builders --> Embed : Texte + metadata
Embed --> Index : Vecteurs 768-d
Index --> Storage : Persistance
Events --> Index : upsert_entity() after_insert/update/delete

Query --> Filters : Requête + params
Filters --> Retriever : Metadata + top_k×2
Retriever --> PostFilter : Résultats bruts
PostFilter --> Results : top-k final

note right of Events
  **Réindexation incrémentale**
  - after_insert : upsert_entity()
  - after_update : upsert_entity() avec
    détection MD5 hash
  - after_delete : delete_entity()
  - Tâches async en arrière-plan
end note

note right of PostFilter
  **Stratégie over-fetching**
  - Récupère top_k × 2 résultats
  - Post-filtre par type, score, prix
  - Compense la logique AND stricte
    de LlamaIndex sur les métadonnées
end note

@enduml